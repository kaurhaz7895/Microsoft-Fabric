table factsales
	lineageTag: bf2687a8-84c6-4330-b9e8-69438c8a5422
	sourceLineageTag: [dbo].[factsales]

	measure 'Total Sales' = SUM(FactSales[SalesAmount])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: c5bddcab-0da1-4e10-b0a4-eeb41b1f7004

		changedProperty = Name

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Total Cost' = SUM(FactSales[TotalCost])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 6ff3dbb7-9c66-44a8-baac-8f1ae71e3347

		changedProperty = Name

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure Profit = ```
			
			 VAR TotalRevenue = [Total Sales]
			 VAR TotalExpense = [Total Cost]
			 RETURN
			     TotalRevenue - TotalExpense
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: bca8194f-49d2-4983-8311-4587a6eaa8b0

		changedProperty = Name

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Profit Margin' = ```
			
			 VAR ProfitAmount = [Profit]
			 VAR TotalRevenue = [Total Sales]
			 RETURN
			     DIVIDE(ProfitAmount, TotalRevenue)
			```
		lineageTag: cc0051f4-904e-49a0-b3ef-7520360ea826

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales by Ship Date' = ```
			
			 CALCULATE(
			     [Total Sales],
			     USERELATIONSHIP(FactSales[ShipDateKey], DimDate[DateKey])
			 )
			```
		lineageTag: c16e2b03-a1f7-47f6-baed-269a032527ea

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

