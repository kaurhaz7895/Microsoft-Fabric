	measure 'Total Sales' = SUM(FactSales[SalesAmount])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: My base measure
		lineageTag: 4829c0ec-c731-40ec-b630-4eb090e8e20e

