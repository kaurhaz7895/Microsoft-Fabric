	measure Profit = ```
			
			 VAR TotalRevenue = [Total Sales]
			 VAR TotalExpense = [Total Cost]
			 RETURN
			     TotalRevenue - TotalExpense
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: My base measure
		lineageTag: 8d3cc142-f670-4c3c-8f7e-7637e6c3f320

		changedProperty = Name

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Profit Margin' = ```
			
			 VAR ProfitAmount = [Profit]
			 VAR TotalRevenue = [Total Sales]
			 RETURN
			     DIVIDE(ProfitAmount, TotalRevenue)
			```
		displayFolder: My base measure
		lineageTag: e69a5235-ff58-459f-a25d-20ff11d126f1

		changedProperty = Name

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales YTD' =
			
